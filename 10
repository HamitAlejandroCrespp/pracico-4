#include <iostream>
using namespace std;
int main() {
    int n, a = 1, b = 1, c;
    cout << "Cuantos terminos deseas ver?: "; cin >> n;
    for(int i = 1; i <= n; i++) {
        if (i == 1 || i == 2) {
            cout << "1 ";
        } else {
            c = a + b;
            cout << c << " ";
            a = b;
            b = c;
        }
    }
    return 0;
}
