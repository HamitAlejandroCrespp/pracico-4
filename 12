#include <iostream>
using namespace std;
int main() {
    int n, divisores = 0;
    cout << "Ingrese N: "; cin >> n;
    for(int i = 1; i <= n; i++) {
        if(n % i == 0) {
            divisores++;
        }
    }
    if(divisores == 2) cout << n << " es primo";
    else cout << n << " no es primo";
    return 0;
}
