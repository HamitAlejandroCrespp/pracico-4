#include <iostream>
using namespace std;
int main() {
    int a, b, originalA, originalB, mcd, mcm;
    cout << "Ingrese A y B: "; cin >> a >> b;
    originalA = a; originalB = b;
    
    // Algoritmo de Euclides
    while(b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    mcd = a;
    mcm = (originalA * originalB) / mcd;
    
    cout << "MCD: " << mcd << endl;
    cout << "MCM: " << mcm << endl;
    return 0;
}
